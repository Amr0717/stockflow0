# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase Dashboard -> Project Settings -> API (or "Connect" button).
#
# These two values are PUBLIC by design (they are sent to the browser).
# Security comes from Supabase Auth + Row Level Security in the migrations.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# NEVER put the service_role / secret key in this app. It is not needed.
